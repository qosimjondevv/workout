# Firebase veb-ilova sozlamalari.
# Firebase konsoli -> Project settings -> General -> Your apps -> SDK setup and configuration
#
# Lokal ishga tushirish: bu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring.
# Vercel: Project -> Settings -> Environment Variables ga xuddi shu nomlar bilan kiriting.
#
# ESLATMA: bu qiymatlar build paytida brauzer kodiga yoziladi, ya'ni to'liq
# maxfiy emas. Ma'lumotni firestore.rules / storage.rules qoidalari himoya qiladi.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
